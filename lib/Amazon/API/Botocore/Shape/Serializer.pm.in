package Amazon::API::Botocore::Shape::Serializer;

use strict;
use warnings;

use parent qw(Class::Accessor::Fast);

use Amazon::API::Constants qw(:chars :booleans);
use Amazon::API::Botocore::Shape::Utils qw(require_shape is_hash is_array parse_timestamp);
use Amazon::API::Botocore::Shape;

use Carp;
use Data::Dumper;
use English qw(-no_match_vars);
use JSON qw(decode_json encode_json);
use Scalar::Util qw(reftype blessed);
use List::Util qw(any none);
use URL::Encode qw(url_decode_utf8);

our $VERSION = '@PACKAGE_VERSION@'; ## no critic (RequireInterpolationOfMetachars)

__PACKAGE__->follow_best_practice;

__PACKAGE__->mk_accessors(qw( service delete_empty_members protocol debug logger ));

########################################################################
sub new {
########################################################################
  my ( $class, @args ) = @_;

  my %options = ref $args[0] ? %{ $args[0] } : @args;

  my $self = $class->SUPER::new( \%options );

  return $self;
}

########################################################################
sub _serialize_structure {
########################################################################
  my ( $self, $this, $data, $service, $exists ) = @_;

  $service ||= $self->get_service;

  my $members = $this->get_members;

  $self->get_logger->debug(
    Dumper [
      class               => ref $this,
      serialize_structure => $this,
      data                => $data,
      exists              => $exists,
      members             => $members,
    ]
  );

  return if !defined $data;

  #  my $result = {};
  my $result = $exists ? {} : undef;

  foreach my $m ( keys %{$members} ) {
    my $member = $members->{$m};

    my $is_payload = $this->{payload} && $m eq $this->{payload};

    my $is_jsonvalue = $member->{jsonvalue};

    my $location_name = $member->{locationName} || $member->{location} || $m;
    next if !exists $data->{$location_name};

    my $has_location
      = ( exists $member->{locationName} ) || ( exists $member->{location} );

    my $shape = $member->{shape};
    my $serialized_data;

    $self->get_logger->debug(
      sub {
        return Dumper(
          [ member_name  => $m,
            member       => $member,
            shape        => $shape,
            location     => $location_name,
            has_location => $has_location,
            exists       => $exists,
          ]
        );
      }
    );

    my $member_data = $data->{$location_name};

    next
      if $self->get_protocol =~ /^(?:json|rest-json)$/xsm
      && !defined $member_data;

    $self->get_logger->debug(
      sub {
        return Dumper(
          [ member       => $m,
            shape        => $shape,
            data         => $data,
            location     => $location_name,
            member_data  => $member_data,
            has_location => $has_location,
            exists       => $exists,
          ]
        );
      }
    );

    # because we may have serialized an XML object...this is a result
    # of how XMLin deserializes XML objects
    if ( $member_data && ref($member_data) && $shape eq 'String' ) {
      $member_data = $member_data->{content} // $EMPTY;
    }

    $self->get_logger->debug(
      sub {
        return Dumper(
          [ member_data   => $member_data,
            member        => $member,
            location_name => $location_name,
            has_location  => $has_location,
            caller_exists => $exists,
            exists        => exists $data->{$location_name},
          ]
        );
      }
    );

    # has location means this structure member should be inserted into
    # a hash at that location - when it doesn't exist the data is
    # inserted directly into the member name

    # if member data does not exist, then entire data structure is
    # passed to the serializer

    if ( !$has_location || exists $data->{$location_name} ) {
      $serialized_data = $self->serialize(
        shape   => $shape,
        data    => exists $data->{$location_name} ? $member_data : $data,
        service => $service,
        exists  => exists $data->{$location_name},
        ( $member->{flattened} ? ( flattened => $TRUE )
          : ()
        ),
        ( $is_payload ? ( payload => $TRUE )
          : ()
        ),
      );

      $self->get_logger->debug(
        sub {
          return Dumper(
            [ "back from serializing $shape",
              data          => $serialized_data,
              location_name => $location_name,
              member        => $m,
              flattened     => $this->{flattened},
            ]
          );
        }
      );
    }

    # skip empty members
    next if ( !exists $data->{$location_name} ) && !defined $serialized_data;

    $result //= {};

    if ( $this->{flattened} ) {
      $result->{$m} = $serialized_data;
    }
    else {
      if ( $self->get_protocol !~ /^(?:json|rest-json)$/xsm
        && $has_location
        && is_hash($serialized_data)
        && exists $serialized_data->{$location_name} ) {
        $result->{$m} = $serialized_data->{$location_name};
      }
      else {
        $result->{$m} = $serialized_data;
      }
    }

    $self->get_logger->debug(
      sub {
        return Dumper(
          [ result          => $result,
            member          => $m,
            serialized_data => $serialized_data,
            location_name   => $location_name,
            exists          => $exists,
          ]
        );
      }
    );
  }

  return $result;
}

########################################################################
sub _serialize_list {
########################################################################
  my ( $self, $this, $data, $service, $exists ) = @_;

  $service ||= $self->get_service;

  $self->get_logger->debug( Dumper( [ 'serialize_list', $this, $data, $service ] ) );

  my $member        = $this->get_member;
  my $location_name = $member->{locationName};

  if ( !$location_name ) {
    if ( ref $data && reftype($data) eq 'HASH' && exists $data->{member} ) {
      $location_name = 'member';
    }
  }

  my $list = $location_name && ref $data && reftype($data) eq 'HASH' ? $data->{$location_name} : $data;

  return [] if defined $list && !ref $list && $list eq $EMPTY;

  my $member_shape = $member->{shape};

  $self->get_logger->debug(
    Dumper(
      [ 'serialize_list',
        member        => $member,
        location_name => $location_name,
        list          => $list,
        member_shape  => $member_shape,
      ]
    )
  );

  my $result = [];

  if ( $list && !ref $list ) {
    $list = [$list];
  }
  elsif ( $list && reftype($list) eq 'HASH' ) {

    my @key_values;

    if ( $this->{flattened} ) {
      $self->get_logger->debug(
        Dumper(
          [ list      => $list,
            flattened => $this->{flattened}
          ]
        )
      );

      my @flattened_list;

      foreach ( keys %{$list} ) {
        if ( reftype( $list->{$_} ) eq 'ARRAY' ) {
          push @flattened_list, @{ $list->{$_} };
        }
      }

      $list = @flattened_list ? \@flattened_list : [ values %{$list} ];
    }
    else {
      $self->get_logger->trace(
        Dumper(
          [ message => 'unreliable deserialization?',
            this    => $this,
            list    => $list,
            data    => $data,
          ]
        )
      );

      $list = [$list];
    }

    $self->get_logger->debug( Dumper( [ key_values => $member_shape, \@key_values ] ) );

    my %result;

    foreach my $p ( @{$list} ) {

      $self->get_logger->debug( Dumper( [ p => $p, member_shape => $member_shape ] ) );

      my $serialized_data = $self->serialize(
        shape   => $member_shape,
        data    => $p,
        service => $service,
        exists  => $location_name && exists $data->{$location_name},
      );

      next if !defined $serialized_data;

      push @{$result}, $serialized_data;
    }

    local $LIST_SEPARATOR = q{,};

    $self->get_logger->debug(
      sub {
        return Dumper(
          [ 'ref(self)' => ref($self),
            'ref(this)' => ref($this),
            result      => $result,
            list        => $list
          ]
        );
      }
    );
  }
  else {
    foreach my $elem ( @{$list} ) {

      $self->get_logger->debug(
        sub {
          return Dumper(
            [ shape => $member->{shape},
              elem  => $elem
            ]
          );
        }
      );

      my $serialized_data = $self->serialize(
        shape   => $member->{shape},
        data    => $elem,
        service => $service,
        exists  => $exists,
      );

      next if !defined $serialized_data;

      push @{$result}, $serialized_data;

    }
  }

  return if !$exists && !@{$result};

  return $result;
}

########################################################################
sub serialize {
########################################################################
  my ( $self, %args ) = @_;

  my ( $shape, $service, $data, $exists, $payload, $flattened ) = @args{qw(shape service data exists payload flattened)};

  $service ||= $self->get_service;

  my $protocol = $self->get_protocol;

  $self->get_logger->debug(
    sub {
      return Dumper(
        [ shape    => $shape,
          data     => $data,
          service  => $service,
          exists   => $exists,
          protocol => $protocol,
        ]
      );
    }
  );

  # this is a hack to deal with the way XML responses are ambiguously
  # returned by rest-xml services and ec2 APIs...sometimes there is a
  # response wrapper that is never articulated in the Botocore
  # metadata...sometimes it is the name of the top-level shape.
  #
  # "$exists" tells us the shape was not found, but it may now be in the
  # data structure if this was a deserialized XML payload and the shape
  # name was the wrapper.
  #
  # We really only want to do this on the top level element but we'll
  # see if this works consistently when serializing all elements below
  # the root.
  #
  # I hate you botocore!!!!
  #
  if ( !$exists ) {
    # if the shape name exists in the data, then that is our data to
    # serialize.
    if ( ref $data && exists $data->{$shape} ) {
      $data = $data->{$shape};
    }
    # else this may be ec2 with a response wrapper
    elsif ( ref $data && reftype($data) eq 'HASH' && $self->get_protocol =~ /^(?:query|ec2)$/xsm ) {
      my ($response_wrapper) = grep {/response$/ixsm}
        keys %{$data};

      $self->get_logger->debug( Dumper( [ response_wrapper => $response_wrapper ] ) );

      if ($response_wrapper) {
        $self->get_logger->debug(
          Dumper(
            [ response_wrapper => $response_wrapper,
              data             => $data,
              shape            => $shape
            ]
          )
        );
        $data   = $data->{$response_wrapper};
        $exists = $TRUE;
        if ( exists $data->{$shape} ) {
          $data = $data->{$shape};
        }
      }
    }
  }

  my $class = require_shape( $shape, $service );

  croak "unable to require class for $shape: $EVAL_ERROR\n"
    if !$class;

  local $Amazon::API::Botocore::Shape::LOGGER_SOURCE = sub { $self->get_logger };

  my $this = $class->new();
  $this->set_logger( $self->get_logger );

  $this->{flattened} = $flattened
    if defined $flattened;

  return $data
    if $this->{document};

  # for REST-XML root-name unwrap immediately
  if (!$exists
    && $protocol eq 'rest-xml'
    && $this->{locationName}
    && ref $data
    && reftype($data) eq 'HASH'
    && exists $data->{ $this->{locationName} } ) {
    $data = $data->{ $this->{locationName} };
  }

  my $type = $this->get_type;

  $self->get_logger->debug(
    sub {
      return Dumper(
        [ class   => $class,
          type    => $type,
          exists  => $exists,
          data    => $data,
          service => $service,
          this    => $this,
        ]
      );
    }
  );

  my %serializers = (
    structure => sub {
      return $self->_serialize_structure( $this, $data, $service, $exists );
    },

    list => sub {
      return $self->_serialize_list( $this, $data, $service, $exists );
    },

    string => sub {

      if ( defined $data ) {
        $data = ref $data && defined $data->{content} ? $data->{content} : $data;
      }

      return $data
        if defined $data;

      return $exists ? $EMPTY : $data;
    },

    boolean => sub {

      if ( ref $data ) {
        if ( !blessed $data ) {
          $data = $data->{content};
        }
      }

      return
        if !defined $data;

      $data //= 0;
      if ( any { $data eq $_ } qw( 0 1 true false) ) {
        my $bool_value = {
          '0'     => 0,
          '1'     => 1,
          'true'  => 1,
          'false' => 0,
        }->{$data};

        # Response deserialization always returns modeled boolean values.
        # Query/EC2 request serialization uses plain 0/1 in Shape.pm because
        # query-string generation cannot consume blessed JSON booleans.
        return $bool_value ? JSON::true : JSON::false;
      }

      return $data;
    },

    integer => sub {
      return ref $data ? $data->{content} : $data;
    },

    long => sub {
      return ref $data ? $data->{content} : $data;
    },

    float => sub {
      $data = ref $data ? $data->{content} : $data;

      return $data
        if defined $data && any { $data eq $_ } qw(NaN Infinity -Infinity);

      return defined $data ? $data * 1.0 : $data;
    },

    double => sub {
      $data = ref $data ? $data->{content} : $data;

      return $data
        if defined $data && any { $data eq $_ } qw(NaN Infinity -Infinity);

      return defined $data ? $data * 1.0 : $data;
    },
    map => sub {

      if (
           ( any { $protocol eq $_ } qw(query ec2 rest-xml) )
        && $exists
        && (
             !defined $data
          || ( ref $data && reftype($data) eq 'HASH' && !keys %{$data} )
          || ( ref $data
            && reftype($data) eq 'HASH'
            && keys %{$data} == 1
            && exists $data->{content} )
        )
      ) {
        return {};
      }

      if ( !$this->{flattened} ) {
        if ( $protocol =~ /^(?:json|rest-json)$/xsm
          && ref $data
          && reftype($data) eq 'HASH' ) {
          my %result;

          foreach my $key ( keys %{$data} ) {
            next
              if !defined $data->{$key};

            $result{$key} = $data->{$key};
          }

          return \%result;
        }

        if ( ( any { $protocol eq $_ } qw{query ec2 rest-xml} )
          && ref $data
          && reftype($data) eq 'HASH'
          && exists $data->{entry} ) {
          $data = $data->{entry};
        }
        else {
          return $data;
        }
      }

      my $serialize           = {};
      my $key_location_name   = $this->{key}->{locationName};
      my $value_location_name = $this->{value}->{locationName};

      if ( any { $protocol eq $_ } qw(query ec2 rest-xml) ) {
        $key_location_name   //= 'key';
        $value_location_name //= 'value';
      }

      my $key_shape_name   = $this->{key}->{shape};
      my $value_shape_name = $this->{value}->{shape};

      $self->get_logger->debug(
        sub {
          return Dumper(
            [ type                => $type,
              data                => $data,
              locationName        => $this->{locationName},
              key_location_name   => $key_location_name,
              key_shape_name      => $key_shape_name,
              value_location_name => $value_location_name,
              value_shape_name    => $value_shape_name,
            ]
          );
        }
      );

      $data ||= [];

      if ( !$key_location_name && !$value_location_name ) {
        $self->get_logger->debug(
          Dumper(
            [ value_shape_name => $value_shape_name,
              data             => $data,
              this             => $this
            ]
          )
        );

        # we might have to serialize this data too, however since it
        # is specified as a structure as a map and we have not
        # information regarding how to actual map it...we return the
        # data itself.
        return $data;
      }

      if ( ref $data && reftype($data) ne 'ARRAY' ) {
        $data = [$data];
      }

      foreach my $item ( @{$data} ) {
        $self->get_logger->debug(
          sub {
            return Dumper( [ item => $item ] );
          }
        );

        my ( $key, $value );

        if ( $key_location_name || $key_shape_name ) {
          $key = $self->serialize(
            service => $service,
            data    => $key_location_name ? $item->{$key_location_name} : $item,
            shape   => $key_shape_name,

          );
        }

        if ( $value_location_name || $value_shape_name ) {

          $value = $self->serialize(
            service => $service,
            data    => $value_location_name ? $item->{$value_location_name} : $item,
            shape   => $value_shape_name,
            exists  => $TRUE,
          );
        }

        # This is almost certainly an unnecessary test as we have
        # handled the situation where location names are not provided
        # above by using the hash keys of the payload as the keys
        # themselves. This occurs in an API like SQS where the
        # attribute names become the keys but are not specifically
        # called out in the shape.
        if ( defined $key && defined $value ) {
          $serialize->{$key} = $value;
        }
        else {
          return $value;
        }
      }

      return $serialize;
    },
    blob => sub {
      if ( ref $data ) {
        $data = $data->{content};
      }

      return $EMPTY
        if !defined $data && $exists;

      return $data
        if !defined $data || $this->{streaming} || $payload;

      require MIME::Base64;

      return MIME::Base64::decode_base64($data);
    },
    timestamp => sub {
      $data
        = ref $data
        ? $data->{content}
        : $data;

      return parse_timestamp($data);
    },
  );

  $self->get_logger->debug(
    sub {
      return Dumper(
        [ unknown_type => $type,
          this         => $this,
          data         => $data,
          exists       => $exists
        ]
      );
    }
  );

  my $result;

  if ( $serializers{$type} ) {
    $result = $serializers{$type}->($exists);
  }
  else {
    $result = $self->serialize(
      shape   => $this->{shape},
      data    => $data,
      service => $service,
      exists  => $exists,
    );
  }

  $self->get_logger->debug( sub { return Dumper( [ result => $result ] ) } );

  return $result;
}

1;
